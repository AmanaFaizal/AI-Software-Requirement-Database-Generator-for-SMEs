  "paths": {
    "/api/auth/register": {
      "post": {
        "operationId": "registerUser",
        "summary": "Create user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created; returns BizGuide JWT and user"
          },
          "400": {
            "description": "name, email and password are required"
          },
          "409": {
            "description": "An account with this email already exists"
          },
          "500": {
            "description": "Backend server error"
          }
        },
        "tags": [
          "Authentication"
        ]
      }
    },
