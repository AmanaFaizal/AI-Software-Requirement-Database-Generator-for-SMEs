{
  "openapi": "3.0.3",
  "info": {
    "title": "BizGuide API",
    "version": "1.0.0",
    "description": "All backend routes grouped by feature. WSO2 validates OAuth; protected routes require X-BizGuide-Token."
  },
  "servers": [
    {
