PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=BizGuide_ai
DB_USER=root
DB_PASSWORD=your_mysql_password

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# direct: Authorization carries BizGuide JWT (existing frontend).
# gateway: X-BizGuide-Token carries Bearer BizGuide-JWT; WSO2 owns Authorization.
BIZGUIDE_AUTH_MODE=direct

# Local verification only. Never commit real tokens.
WSO2_GATEWAY_URL=https://localhost:8243/bizguide/1.0.0
WSO2_ACCESS_TOKEN=
# Alternative for Publisher Try Out testing; OAuth evidence should use ACCESS_TOKEN.
WSO2_INTERNAL_KEY=
# Local self-signed certificate opt-in, restricted to loopback by the test runner.
WSO2_ALLOW_SELF_SIGNED=false
